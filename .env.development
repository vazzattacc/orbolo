# Dev only (specs/005-contact-form, research.md §3). Vite loads this file for
# `astro dev` and never for `astro build`, so nothing here reaches production.
# No secrets: `.test` is a reserved TLD that can never resolve (RFC 6761), and
# every e2e test intercepts it. CONTACT_FORM_PREVIEW shows the contact form
# locally before the real endpoint and privacy approval exist.
PUBLIC_CONTACT_ENDPOINT=https://contact-endpoint.orbolo.test/contact
CONTACT_FORM_PREVIEW=true
