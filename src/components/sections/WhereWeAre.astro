---
interface DatedItem {
  text: string;
  date: string;
}
interface Props {
  operating: DatedItem[];
  building: DatedItem[];
  next: DatedItem[];
  lastUpdated: string;
}
const { operating, building, next, lastUpdated } = Astro.props;

const columns: { title: string; items: DatedItem[] }[] = [
  { title: "Operating", items: operating },
  { title: "Building", items: building },
  { title: "Next", items: next },
];
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6" aria-labelledby="where-we-are-heading">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="where-we-are-heading" class="font-display text-3xl">Where we are</h2>
    <p class="text-sm text-ink/60">Last updated {lastUpdated}</p>
  </div>
  <div class="mt-6 grid grid-cols-1 gap-8 sm:grid-cols-3">
    {
      columns.map((column) => (
        <div>
          <h3 class="text-sm uppercase tracking-wide text-ink/60">{column.title}</h3>
          <ul class="mt-2 flex flex-col gap-2">
            {column.items.map((item) => (
              <li>
                {item.text} <span class="text-xs text-ink/50">({item.date})</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
