---
import { filterDisplayablePartners, getAllPartners } from "@/lib/content/partners";

interface Props {
  partnerSlugs: string[];
}
const { partnerSlugs } = Astro.props;

const allPartners = await getAllPartners();
// FR-035: never render a partner without a role — see lib/content/partners.ts.
const partners = filterDisplayablePartners(allPartners, partnerSlugs);
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4" role="list" aria-label="Partners">
    {
      partners.map((partner) => (
        <li class="flex flex-col items-center gap-3 border border-ink/15 p-6 text-center">
          <img src={partner.logo} alt={partner.name} class="h-10 w-auto grayscale" width="120" height="40" loading="lazy" />
          <span class="text-xs text-ink/60">{partner.role}</span>
        </li>
      ))
    }
  </ul>
</section>
