---
interface Stage {
  label: string;
  href: string;
}
interface Props {
  stages: Stage[];
  whyTogetherLines: string[];
}
const { stages, whyTogetherLines } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6" aria-labelledby="loop-heading">
  <h2 id="loop-heading" class="font-display text-3xl">One group, two engines</h2>
  <ol class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-4" role="list">
    {
      stages.map((stage, index) => (
        <li
          class="motion-safe:animate-[fade-in_0.4s_ease-out_backwards] border border-verified/30 p-4"
          style={`animation-delay: ${index * 150}ms`}
        >
          <span class="text-sm text-verified">{index + 1}</span>
          <a href={stage.href} class="mt-1 block font-medium hover:underline focus-visible:underline">
            {stage.label}
          </a>
        </li>
      ))
    }
  </ol>
  <div class="mt-6 flex flex-col gap-1 text-ink/80">
    {whyTogetherLines.map((line) => <p>{line}</p>)}
  </div>
</section>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
