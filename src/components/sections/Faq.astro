---
interface Item {
  question: string;
  answer: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6" aria-labelledby="faq-heading">
  <div class="max-w-3xl">
    <h2 id="faq-heading" class="font-display text-3xl">FAQ</h2>
    <div class="mt-6 flex flex-col gap-4">
      {
        items.map((item) => (
          <details class="border-b border-ink/10 pb-4">
            <summary class="cursor-pointer font-medium">{item.question}</summary>
            <p class="mt-2 text-ink/70">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
