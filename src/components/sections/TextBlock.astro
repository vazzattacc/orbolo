---
interface Props {
  heading?: string;
  body: string;
}
const { heading, body } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
  <div class="max-w-3xl">
    {heading && <h2 class="font-display text-2xl">{heading}</h2>}
    <div class="mt-4 flex flex-col gap-3 text-ink/80">
      {body.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>
