---
interface Item {
  claim: string;
  proof: string;
}
interface Props {
  heading?: string;
  items: Item[];
}
const { heading, items } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  {heading && <h2 class="font-display text-3xl">{heading}</h2>}
  <ol class="mt-6 flex flex-col gap-6">
    {
      items.map((item, index) => (
        <li class="grid grid-cols-1 gap-2 border-t border-ink/10 pt-4 sm:grid-cols-[1fr_1fr]">
          <p>
            <span class="text-ink/40">{index + 1}.</span> {item.claim}
          </p>
          <p class="text-sm text-ink/60">{item.proof}</p>
        </li>
      ))
    }
  </ol>
</section>
