---
import { ClientRouter } from "astro:transitions";
import Nav from "./Nav.astro";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-orbolo-cream focus:px-4 focus:py-2 focus:text-orbolo-green">
      Skip to content
    </a>
    <Nav />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
