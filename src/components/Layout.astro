---
import { ClientRouter } from "astro:transitions";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import { getPageMeta } from "@/lib/pageMeta/page-meta-repository";
import { getSocialPreviewDefaults } from "@/lib/settings/settings-repository";
import "../styles/global.css";

interface Props {
  title: string;
  /**
   * Overrides the automatic pageMeta lookup (keyed by route) — used only by
   * the 404 page, which is deliberately not a pageMeta entry (data-model.md).
   * Every other page leaves this unset and gets its description/indexable
   * state from pageMeta automatically, keyed off Astro.url.pathname.
   */
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
// Astro's directory-style static build means Astro.url.pathname is
// "/invest/" (trailing slash) at render time, but pageMeta.json's routes
// are written without one ("/invest") to match how every <a href> in Nav/
// CrossLink/etc. is already written site-wide — normalize here rather
// than storing two different conventions.
const route = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
const pageMeta = await getPageMeta(route);
const social = await getSocialPreviewDefaults();

const canonicalUrl = new URL(route, Astro.site).href;
const ogImageUrl = new URL(social.socialImagePath, Astro.site).href;
const isNoindex = noindex || (pageMeta ? !pageMeta.indexable : false);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {pageMeta?.description && <meta name="description" content={pageMeta.description} />}
    {isNoindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- FR-SEO-003: complete social-preview set -->
    <meta property="og:title" content={title} />
    {pageMeta?.description && <meta property="og:description" content={pageMeta.description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={social.siteName} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={social.socialImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- FR-AN-001/002/003/004 (research.md §7): Plausible's own domain
         matching means a view is only ever recorded when the request
         really came from orbolo.com — no env-conditional logic needed for
         local/preview hosts to stay silent. -->
    <script defer data-domain="orbolo.com" src="https://plausible.io/js/script.js"></script>

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-orbolo-cream focus:px-4 focus:py-2 focus:text-orbolo-green">
      Skip to content
    </a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
