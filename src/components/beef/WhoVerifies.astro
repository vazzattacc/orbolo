---
import Edit from "@/components/ui/Edit.astro";

interface Verifier {
  role: string;
  name: string;
}

interface Props {
  codeReferenceNote: string;
  verifiers?: Verifier[];
}

const { codeReferenceNote, verifiers } = Astro.props;
---

<Edit aria-labelledby="beef-who-verifies-heading" rule={false}>
  <h2 slot="head" id="beef-who-verifies-heading" class="h2 t-lime" data-split>Who verifies what</h2>
  <p class="lede">{codeReferenceNote}</p>
  {
    verifiers && verifiers.length > 0 && (
      <ul class="rows rows--plain" role="list">
        {verifiers.map((v) => (
          <li>
            <span class="rows__label">{v.role}:</span> <span class="copy rows__text">{v.name}</span>
          </li>
        ))}
      </ul>
    )
  }
</Edit>
