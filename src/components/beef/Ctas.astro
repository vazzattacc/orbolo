---
import { photos } from "@/assets/photos";
import CtaCollage from "@/components/ui/CtaCollage.astro";
import Btn from "@/components/ui/Btn.astro";
import { useI18n } from "@/i18n";

interface Cta {
  label: string;
  href: string;
}

interface Props {
  ctas: Cta[];
}

const { ctas } = Astro.props;
const { t } = useI18n(Astro.url);
---

<CtaCollage
  aria-label={t.beef.getInTouch}
  class="sec--rule"
  images={["/images/site/orbolo-cattle-shade.jpg", photos.cowGrazing, "/images/site/brahman-four.jpg"]}
  focus={[undefined, "42% 47%", undefined]}
>
  <p class="h2 t-paper max-w-[8em]" aria-hidden="true" data-split>{t.beef.getInTouch}</p>
  <Fragment slot="buttons">
    {ctas.map((cta, index) => <Btn href={cta.href} label={cta.label} variant={index === 0 ? "light" : "paper"} />)}
  </Fragment>
</CtaCollage>
