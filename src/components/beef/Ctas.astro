---
import CtaCollage from "@/components/ui/CtaCollage.astro";
import Btn from "@/components/ui/Btn.astro";

interface Cta {
  label: string;
  href: string;
}

interface Props {
  ctas: Cta[];
}

const { ctas } = Astro.props;
---

<CtaCollage
  aria-label="Get in touch about beef"
  class="sec--rule"
  images={["/images/site/orbolo-cattle-shade.jpg", "/images/site/rider-green.jpg", "/images/site/brahman-four.jpg"]}
>
  <p class="h2 t-paper max-w-[8em]" aria-hidden="true" data-split>Get in touch about beef</p>
  <Fragment slot="buttons">
    {ctas.map((cta, index) => <Btn href={cta.href} label={cta.label} variant={index === 0 ? "light" : "paper"} />)}
  </Fragment>
</CtaCollage>
