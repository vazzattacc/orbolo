---
interface Cta {
  label: string;
  href: string;
}

interface Props {
  ctas: Cta[];
}

const { ctas } = Astro.props;
---

<section
  aria-label="Get in touch about beef"
  class="scroll-bg px-4 py-20 text-center"
  style="--scroll-bg-image: url('/images/beef/ctas-background.jpg')"
>
  <div class="mx-auto flex max-w-3xl flex-wrap justify-center gap-4">
    {
      ctas.map((cta, index) => (
        <a
          href={cta.href}
          class={
            index === 0
              ? "font-title rounded-full bg-orbolo-green px-6 py-3 text-orbolo-cream outline-none hover:bg-orbolo-accent focus-visible:ring-2 focus-visible:ring-orbolo-green focus-visible:ring-offset-2"
              : "font-title rounded-full border border-orbolo-green px-6 py-3 text-orbolo-green outline-none hover:bg-orbolo-green/5 focus-visible:ring-2 focus-visible:ring-orbolo-green focus-visible:ring-offset-2"
          }
        >
          {cta.label}
        </a>
      ))
    }
  </div>
</section>
