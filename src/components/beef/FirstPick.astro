---
import Band from "@/components/ui/Band.astro";
import { useI18n } from "@/i18n";

interface Props {
  body: string;
}

const { body } = Astro.props;
const { t } = useI18n(Astro.url);
---

<Band image="/images/site/nelore-herd.jpg" aria-labelledby="first-pick-heading">
  <h2 id="first-pick-heading" class="h2 t-lime" data-split>{t.beef.firstPick}</h2>
  <Fragment slot="foot">
    <div class="card card--glass">
      <p class="copy">{body}</p>
    </div>
  </Fragment>
</Band>
