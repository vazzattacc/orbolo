---
import Band from "@/components/ui/Band.astro";

interface Props {
  body: string;
}

const { body } = Astro.props;
---

<Band image="/images/site/nelore-herd.jpg" aria-labelledby="first-pick-heading">
  <h2 id="first-pick-heading" class="h2 t-lime" data-split>First pick</h2>
  <Fragment slot="foot">
    <div class="card card--glass">
      <p class="copy">{body}</p>
    </div>
  </Fragment>
</Band>
