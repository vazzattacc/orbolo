---
import Edit from "@/components/ui/Edit.astro";

interface Milestone {
  stage: string;
  body: string;
  targetDate?: string;
}

interface Props {
  milestones?: Milestone[];
}

const { milestones } = Astro.props;
---

{
  milestones && milestones.length > 0 && (
    <Edit aria-labelledby="roadmap-heading">
      <h2 slot="head" id="roadmap-heading" class="h2 t-lime" data-split>
        Roadmap
      </h2>
      <ol class="rows rows--plain" role="list">
        {milestones.map((m) => (
          <li>
            <span class="rows__label">{m.stage}</span>
            <div class="rows__text">
              {m.targetDate && <span class="caps caps--sm t-lime">({m.targetDate})</span>}
              <p class="copy">{m.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </Edit>
  )
}
