---
import PhotoHero from "@/components/ui/PhotoHero.astro";

interface Props {
  headline: string;
  allianceNote: string;
}

const { headline, allianceNote } = Astro.props;
---

<PhotoHero image="/images/site/orbolo-grassfed.jpg" scrollCue>
  <h1 class="h1 t-paper" data-split>{headline}</h1>
  <Fragment slot="side">
    <p class="caps">{allianceNote}</p>
  </Fragment>
</PhotoHero>
