---
import Split from "@/components/ui/Split.astro";
import { useI18n } from "@/i18n";

interface Props {
  body: string;
}

const { body } = Astro.props;
const { t } = useI18n(Astro.url);
---

<Split
  image="/images/site/shade-tree.jpg"
  alt={t.beef.whyDifferentAlt}
  reverse
  sketch
  aria-labelledby="why-different-heading"
>
  <h2 id="why-different-heading" class="h2 t-paper" data-split>{t.beef.whyDifferent}</h2>
  <Fragment slot="foot">
    <p class="lede">{body}</p>
  </Fragment>
</Split>
