---
import Split from "@/components/ui/Split.astro";

interface Props {
  body: string;
}

const { body } = Astro.props;
---

<Split
  image="/images/site/shade-tree.jpg"
  alt="Cattle walk across open pasture beside a lone tree."
  reverse
  sketch
  aria-labelledby="why-different-heading"
>
  <h2 id="why-different-heading" class="h2 t-paper" data-split>Why supply from the group is different</h2>
  <Fragment slot="foot">
    <p class="lede">{body}</p>
  </Fragment>
</Split>
