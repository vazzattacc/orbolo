---
import Edit from "@/components/ui/Edit.astro";

interface Props {
  body: string;
}

const { body } = Astro.props;
---

<Edit aria-labelledby="promise-heading" rule={false}>
  <h2 slot="head" id="promise-heading" class="h2 t-paper" data-split>The promise</h2>
  <p class="lede">{body}</p>
</Edit>
