---
import Split from "@/components/ui/Split.astro";

interface Props {
  body: string;
  noFullHistoryNote: string;
}

const { body, noFullHistoryNote } = Astro.props;
---

<Split image="/images/site/zebu-close.jpg" alt="A light zebu cow in green pasture." aria-labelledby="what-we-sell-heading">
  <h2 id="what-we-sell-heading" class="h2 t-lime" data-split>What we sell today</h2>
  <Fragment slot="foot">
    <p class="lede">{body}</p>
    <p class="caps caps--sm max-w-[32em]">{noFullHistoryNote}</p>
  </Fragment>
</Split>
