---
/**
 * Persistent top navigation bar (FR-GEN-009). The link set is a fixed,
 * code-level list, not content (research.md §3) — it only grows when a new
 * page actually ships, which is a code change regardless. Contact is
 * included now even though its real destination is still pending
 * (OQ-015) — it points at the stub page in src/pages/contact.astro.
 *
 * Layout follows the preview site's bar (links left, wordmark centre,
 * Contact right, fixed over the hero), but without its hamburger: every
 * link stays permanently visible and keyboard-reachable, with no JS-driven
 * open/close state to get wrong. motion.ts only adds the scrolled backdrop
 * and steps the bar out of the way while reading downward.
 */
const NAV_LINKS = [
  { label: "Home", href: "/" },
  { label: "Remote Rancher", href: "/invest" },
  { label: "Beef", href: "/beef" },
  { label: "Land", href: "/land" },
] as const;
const CONTACT = { label: "Contact", href: "/contact" } as const;

// Astro.url.pathname is "/invest/" (trailing slash) at render time for a
// directory-style static build, but every href above is written without
// one — normalize so aria-current actually matches (previously silently
// never did, except on "/").
const currentPath = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
---

<nav aria-label="Primary" class="nav" data-nav>
  <div class="nav__group">
    {
      NAV_LINKS.map((link) => (
        <a href={link.href} class="caps ulink" aria-current={currentPath === link.href ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
  </div>
  <a class="nav__logo" href="/" aria-label="Orbolo home">
    <img src="/images/brand/logo-paper.svg" alt="" width="470" height="219" />
  </a>
  <div class="nav__group nav__group--end">
    <a href={CONTACT.href} class="caps ulink" aria-current={currentPath === CONTACT.href ? "page" : undefined}>
      {CONTACT.label}
    </a>
  </div>
</nav>
