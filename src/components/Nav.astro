---
/**
 * Persistent top navigation bar (FR-GEN-009). The link set is a fixed,
 * code-level list, not content (spec 002 R3) — it only grows when a new
 * page actually ships, which is a code change regardless. Contact is
 * included now even though its real destination is still pending
 * (OQ-015) — it points at the stub page in src/pages/contact.astro.
 *
 * Layout follows the preview site's bar (links left, wordmark centre,
 * Contact right, fixed over the hero), but without its hamburger: every
 * link stays permanently visible and keyboard-reachable, with no JS-driven
 * open/close state to get wrong. motion.ts only adds the scrolled backdrop
 * and steps the bar out of the way while reading downward.
 */
import { LOCALES, isLocalizedRoute, localizePath, stripLocale, useI18n } from "@/i18n";
import { ui } from "@/i18n/ui";

const { locale, t, path } = useI18n(Astro.url);
const NAV_LINKS = [
  { label: t.nav.home, href: path("/") },
  { label: t.nav.remoteRancher, href: path("/invest") },
  { label: t.nav.beef, href: path("/beef") },
  { label: t.nav.land, href: path("/land") },
];
const ABOUT = { label: t.nav.about, href: path("/about") };
const CONTACT = { label: t.nav.contact, href: path("/contact") };
// the language switch points at this same page in the other language, or
// at the home page for English-only pages (Privacy, Terms, 404). Each link's
// accessible name starts with its visible text ("EN – English"), so the
// visible label is part of the name (WCAG 2.5.3 Label in Name).
const baseRoute = stripLocale(Astro.url.pathname);
const switchRoute = isLocalizedRoute(baseRoute) ? baseRoute : "/";

// Astro.url.pathname is "/invest/" (trailing slash) at render time for a
// directory-style static build, but every href above is written without
// one — normalize so aria-current actually matches (previously silently
// never did, except on "/").
const currentPath = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
---

<nav aria-label={t.nav.label} class="nav" data-nav>
  <div class="nav__group">
    {
      NAV_LINKS.map((link) => (
        <a href={link.href} class="caps ulink" aria-current={currentPath === link.href ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
  </div>
  <a class="nav__logo" href={path("/")} aria-label={t.nav.logo}>
    <img src="/images/brand/logo-paper.svg" alt="" width="470" height="219" />
  </a>
  <div class="nav__group nav__group--end">
    <a href={ABOUT.href} class="caps ulink" aria-current={currentPath === ABOUT.href ? "page" : undefined}>
      {ABOUT.label}
    </a>
    <a href={CONTACT.href} class="caps ulink" aria-current={currentPath === CONTACT.href ? "page" : undefined}>
      {CONTACT.label}
    </a>
    <span class="nav__lang caps" role="group" aria-label={t.nav.language}>
      {
        LOCALES.map((l, i) => (
          <>
            {i > 0 && <span aria-hidden="true">/</span>}
            <a
              href={localizePath(switchRoute, l)}
              hreflang={l}
              lang={l}
              class="ulink"
              aria-label={`${l.toUpperCase()} – ${ui[l].langName}`}
              aria-current={l === locale ? "true" : undefined}
            >
              {l.toUpperCase()}
            </a>
          </>
        ))
      }
    </span>
  </div>
</nav>
