---
import PhotoHero from "@/components/ui/PhotoHero.astro";
import Btn from "@/components/ui/Btn.astro";

interface Props {
  heading: string;
  body: string;
  homeLinkLabel: string;
}

const { heading, body, homeLinkLabel } = Astro.props;
---

<PhotoHero image="/images/site/orbolo-walk.jpg" center>
  <h1 class="h1 h1--xl t-paper" data-split>{heading}</h1>
  <p class="caps max-w-[28em]">{body}</p>
  <div><Btn href="/" label={homeLinkLabel} variant="paper" /></div>
</PhotoHero>
