---
import { getContractingEntityName } from "@/lib/settings/settings-repository";
import CtaCollage from "@/components/ui/CtaCollage.astro";
import Btn from "@/components/ui/Btn.astro";

interface Cta {
  label: string;
  href: string;
}

interface Props {
  releaseLine: string;
  ctas: Cta[];
}

const { releaseLine, ctas } = Astro.props;
const contractingEntityName = await getContractingEntityName();
---

<CtaCollage id="closing" aria-labelledby="closing-heading" class="sec--rule">
  <h2 id="closing-heading" class="h2 t-lime max-w-[10em]" data-split>{releaseLine}</h2>
  <p class="caps caps--sm">Contracting entity: {contractingEntityName}</p>
  <Fragment slot="buttons">
    {ctas.map((cta, index) => <Btn href={cta.href} label={cta.label} variant={index === 0 ? "light" : "paper"} />)}
  </Fragment>
</CtaCollage>
