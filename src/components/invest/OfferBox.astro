---
import Split from "@/components/ui/Split.astro";

interface Props {
  included: string[];
  termsOnRequestNote: string;
}

const { included, termsOnRequestNote } = Astro.props;
---

<Split
  image="/images/site/gaucho-nelore.jpg"
  alt="A rider moves a herd of white zebu cattle across green pasture."
  aria-labelledby="offer-box-heading"
>
  <h2 id="offer-box-heading" class="h2 t-lime" data-split>What’s included</h2>
  <Fragment slot="foot">
    <ul class="rows" role="list" data-reveal-group>
      {
        included.map((item, i) => (
          <li>
            <span class="rows__num">{String(i + 1).padStart(2, "0")}</span>
            <span class="caps rows__text">{item}</span>
          </li>
        ))
      }
    </ul>
    <p class="caps caps--sm">{termsOnRequestNote}</p>
  </Fragment>
</Split>
