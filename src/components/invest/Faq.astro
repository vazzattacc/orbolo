---
import Edit from "@/components/ui/Edit.astro";

interface Item {
  question: string;
  answer: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<Edit aria-labelledby="invest-faq-heading">
  <h2 slot="head" id="invest-faq-heading" class="h2 t-paper" data-split>FAQ</h2>
  <div class="faq">
    {
      items.map((item) => (
        <details>
          <summary>
            {item.question}
            <span class="faq__icon" aria-hidden="true" />
          </summary>
          <p class="copy faq__answer">{item.answer}</p>
        </details>
      ))
    }
  </div>
</Edit>
