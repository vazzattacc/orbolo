---
interface Props {
  headline: string;
  releaseRule: string;
  ctaLabel: string;
  ctaHref: string;
}

const { headline, releaseRule, ctaLabel, ctaHref } = Astro.props;
---

<section
  class="scroll-bg flex min-h-[70vh] flex-col items-center justify-center gap-6 px-4 py-20 text-center"
  style="--scroll-bg-image: url('/images/invest/hero-background.jpg')"
>
  <h1 class="font-subtitle text-balance max-w-3xl text-4xl text-orbolo-green sm:text-5xl">{headline}</h1>
  <p class="font-body max-w-2xl text-lg text-orbolo-green/80">{releaseRule}</p>
  <a
    href={ctaHref}
    class="font-title rounded-full bg-orbolo-green px-6 py-3 text-orbolo-cream outline-none hover:bg-orbolo-accent focus-visible:ring-2 focus-visible:ring-orbolo-green focus-visible:ring-offset-2"
  >
    {ctaLabel}
  </a>
</section>
