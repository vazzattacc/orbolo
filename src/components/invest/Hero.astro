---
import PhotoHero from "@/components/ui/PhotoHero.astro";
import Btn from "@/components/ui/Btn.astro";

interface Props {
  headline: string;
  releaseRule: string;
  ctaLabel: string;
  ctaHref: string;
}

const { headline, releaseRule, ctaLabel, ctaHref } = Astro.props;
---

<PhotoHero image="/images/site/rider-herd.jpg" scrollCue>
  <h1 class="h1 t-paper" data-split>{headline}</h1>
  <Fragment slot="side">
    <p class="caps">{releaseRule}</p>
    <Btn href={ctaHref} label={ctaLabel} variant="paper" />
  </Fragment>
</PhotoHero>
