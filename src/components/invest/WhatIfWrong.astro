---
import { useI18n } from "@/i18n";
interface Category {
  label: string;
  body: string;
}

interface Props {
  categories: Category[];
  dataRoomNote: string;
}

const { categories, dataRoomNote } = Astro.props;
const { t } = useI18n(Astro.url);
---

<section aria-labelledby="what-if-wrong-heading" class="sec sec--rule flex flex-col gap-[3.6em]">
  <h2 id="what-if-wrong-heading" class="h2 t-lime max-w-[14em]" data-split>{t.invest.goesWrong}</h2>
  <dl class="cards cards--stagger" data-reveal-group>
    {
      categories.map((category, i) => (
        <div class="card">
          {/* a <dt>, not a <span>: inside a <dl> group only <dt>/<dd> are allowed (WCAG 1.3.1) */}
          <dt class="card__tag caps caps--sm">{t.invest.risk} {String(i + 1).padStart(2, "0")}</dt>
          <dt class="h3">{category.label}</dt>
          <dd class="copy m-0">{category.body}</dd>
        </div>
      ))
    }
  </dl>
  <p class="caps max-w-[40em]" data-reveal>{dataRoomNote}</p>
</section>
