---
interface Category {
  label: string;
  body: string;
}

interface Props {
  categories: Category[];
  dataRoomNote: string;
}

const { categories, dataRoomNote } = Astro.props;
---

<section aria-labelledby="what-if-wrong-heading" class="sec sec--rule flex flex-col gap-[3.6em]">
  <h2 id="what-if-wrong-heading" class="h2 t-lime max-w-[14em]" data-split>What if it goes wrong?</h2>
  <dl class="cards cards--stagger" data-reveal-group>
    {
      categories.map((category, i) => (
        <div class="card">
          <span class="card__tag caps caps--sm">Risk {String(i + 1).padStart(2, "0")}</span>
          <dt class="h3">{category.label}</dt>
          <dd class="copy m-0">{category.body}</dd>
        </div>
      ))
    }
  </dl>
  <p class="caps max-w-[40em]" data-reveal>{dataRoomNote}</p>
</section>
