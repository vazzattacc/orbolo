---
import Split from "@/components/ui/Split.astro";

interface Props {
  body: string;
}

const { body } = Astro.props;
---

<Split
  image="/images/site/grazing-bright.jpg"
  alt="Cattle grazing on bright green pasture."
  reverse
  sketch
  aria-labelledby="who-buys-heading"
>
  <h2 id="who-buys-heading" class="h2 t-lime" data-split>Who buys the animal at the end?</h2>
  <Fragment slot="foot">
    <p class="lede">{body}</p>
  </Fragment>
</Split>
