---
import { getRanches } from "@/lib/ranches/ranches-repository";

interface Props {
  ranchSlugs?: string[];
}

const { ranchSlugs } = Astro.props;
const allRanches =
  ranchSlugs && ranchSlugs.length > 0
    ? (await getRanches()).filter((ranch) => ranchSlugs.includes(ranch.id))
    : [];
// Public pipeline cards are scoped to exactly the slugs this page names —
// see contracts/nav-and-hidden-sections.md: the whole section is absent
// (not just empty) when there's nothing real to show (OQ-008).
---

{
  allRanches.length > 0 && (
    <section aria-labelledby="deployment-pipeline-heading" class="sec sec--rule flex flex-col gap-[3.6em]">
      <h2 id="deployment-pipeline-heading" class="h2 t-lime" data-split>
        Deployment pipeline
      </h2>
      <ul class="cards cards--stagger" role="list" data-reveal-group>
        {allRanches.map((ranch) => (
          <li class="card">
            <span class="card__tag caps caps--sm">{ranch.status}</span>
            <p class="h3">{ranch.codename}</p>
            <p class="caps caps--sm">
              {ranch.region} · {ranch.hectares} ha · {ranch.grazingSystem}
            </p>
            <p class="caps caps--sm t-lime">
              {ranch.committedUnderLoi} / {ranch.threshold} committed · {ranch.status}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )
}
