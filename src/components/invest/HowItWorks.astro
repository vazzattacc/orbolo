---
import Edit from "@/components/ui/Edit.astro";

interface Step {
  step: number;
  body: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<Edit aria-labelledby="how-it-works-heading">
  <h2 slot="head" id="how-it-works-heading" class="h2 t-paper" data-split>How it works</h2>
  <ol class="rows rows--start" role="list">
    {
      steps.map((s) => (
        <li>
          <span class="rows__num">{String(s.step).padStart(2, "0")}.</span>
          <span class="copy rows__text">{s.body}</span>
        </li>
      ))
    }
  </ol>
</Edit>
