---
import Edit from "@/components/ui/Edit.astro";

interface Props {
  releaseRuleBody: string;
  loiExpiryBody: string;
}

const { releaseRuleBody, loiExpiryBody } = Astro.props;
---

<Edit aria-labelledby="what-if-not-enough-heading" rule={false}>
  <h2 slot="head" id="what-if-not-enough-heading" class="h2 t-paper" data-split>What if not enough people join?</h2>
  <p class="lede">{releaseRuleBody}</p>
  <p class="copy">{loiExpiryBody}</p>
</Edit>
