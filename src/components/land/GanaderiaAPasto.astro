---
import MetricValue from "@/components/shared/MetricValue.astro";
import Split from "@/components/ui/Split.astro";

interface Props {
  body: string;
  hectaresMetricKey: string;
}

const { body, hectaresMetricKey } = Astro.props;
---

<Split image="/images/site/rider-green.jpg" alt="A rider moves cattle across pasture." aria-labelledby="gapp-heading" sketch>
  <h2 id="gapp-heading" class="h2 t-paper" data-split>Ganadería a Pasto</h2>
  <Fragment slot="foot">
    <p class="lede">{body}</p>
    <p class="caps">Ganadería a Pasto operates across <MetricValue metricKey={hectaresMetricKey} />.</p>
  </Fragment>
</Split>
