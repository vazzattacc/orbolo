---
import CtaCollage from "@/components/ui/CtaCollage.astro";
import Btn from "@/components/ui/Btn.astro";

interface Props {
  ctaLabel: string;
  ctaHref: string;
}

const { ctaLabel, ctaHref } = Astro.props;
---

<CtaCollage aria-labelledby="work-with-us-heading" class="sec--rule">
  <h2 id="work-with-us-heading" class="h2 t-lime max-w-[9em]" data-split>Own land in Paraguay?</h2>
  <p class="caps max-w-[27em]">Bring your ranch into the system. Cattle graze under the trees, not instead of them.</p>
  <Fragment slot="buttons">
    <Btn href={ctaHref} label={ctaLabel} />
  </Fragment>
</CtaCollage>
