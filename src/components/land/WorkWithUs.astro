---
interface Props {
  ctaLabel: string;
  ctaHref: string;
}

const { ctaLabel, ctaHref } = Astro.props;
---

<section
  aria-labelledby="work-with-us-heading"
  class="mx-auto flex max-w-3xl flex-col items-center gap-6 px-4 py-16 text-center"
>
  <h2 id="work-with-us-heading" class="font-subtitle text-3xl text-orbolo-green">Own land in Paraguay?</h2>
  <p class="font-body text-lg text-orbolo-green/80">
    Put idle or underused land to work in a managed grazing partnership.
  </p>
  <a
    href={ctaHref}
    class="font-title rounded-full bg-orbolo-green px-6 py-3 text-orbolo-cream outline-none hover:opacity-90 focus-visible:ring-2 focus-visible:ring-orbolo-green focus-visible:ring-offset-2"
  >
    {ctaLabel}
  </a>
</section>
