---
import MetricValue from "@/components/shared/MetricValue.astro";

interface Props {
  intro: string;
  hectaresMetricKey: string;
  expansionTargetNote?: string;
}

const { intro, hectaresMetricKey, expansionTargetNote } = Astro.props;
---

<section aria-labelledby="el-tapir-heading" class="mx-auto flex max-w-3xl flex-col gap-4 px-4 py-16">
  <h1 id="el-tapir-heading" class="font-subtitle text-4xl text-orbolo-green">El Tapir</h1>
  <p class="font-body text-lg text-orbolo-green/80">{intro}</p>
  <p class="font-body text-orbolo-green/80">
    El Tapir spans <MetricValue metricKey={hectaresMetricKey} />.
  </p>
  {expansionTargetNote && <p class="font-body text-orbolo-green/80">{expansionTargetNote}</p>}
</section>
