---
import { getRanches } from "@/lib/ranches/ranches-repository";

interface Props {
  ranchSlugs?: string[];
}

const { ranchSlugs } = Astro.props;
const allRanches =
  ranchSlugs && ranchSlugs.length > 0
    ? (await getRanches()).filter((ranch) => ranchSlugs.includes(ranch.id))
    : [];
// Public-layer fields only — see contracts/nav-and-hidden-sections.md.
---

{
  allRanches.length > 0 && (
    <section aria-labelledby="partner-ranches-heading" class="sec flex flex-col gap-[3.6em]">
      <h2 id="partner-ranches-heading" class="h2 t-lime" data-split>
        Partner ranches
      </h2>
      <ul class="cards cards--stagger" role="list" data-reveal-group>
        {allRanches.map((ranch) => (
          <li class="card">
            <p class="h3">{ranch.codename}</p>
            <p class="caps caps--sm">
              {ranch.region} · {ranch.hectares} ha · {ranch.grazingSystem}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )
}
