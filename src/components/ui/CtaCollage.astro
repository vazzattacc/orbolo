---
/**
 * Closing call-to-action: text and buttons on the left, a collage of
 * photos and forest squares meeting corner to corner on the right.
 */
import type { HTMLAttributes } from "astro/types";
import type { Photo as PhotoSource } from "@/assets/photos";
import Photo from "./Photo.astro";

type CollageImage = string | PhotoSource;

interface Props extends HTMLAttributes<"section"> {
  /** Paths into public/ (kept photos) or replacements from src/assets/photos. */
  images?: [CollageImage, CollageImage, CollageImage];
  /** CSS object-position per image, in the same order. */
  focus?: [string?, string?, string?];
}

const {
  images = ["/images/site/orbolo-cattle-shade.jpg", "/images/site/florian.jpg", "/images/site/orbolo-walk.jpg"],
  focus = [],
  class: className,
  ...rest
} = Astro.props;
---

<section class:list={["cta", className]} {...rest}>
  <div class="cta__text">
    <slot />
    {Astro.slots.has("buttons") && <div class="cta__btns"><slot name="buttons" /></div>}
  </div>
  <div class="cta__collage" aria-hidden="true">
    <Photo class="c1" image={images[0]} alt="" kind="collage" focus={focus[0]} />
    <Photo class="c2" image={images[1]} alt="" kind="collage" focus={focus[1]} />
    <Photo class="c3" image={images[2]} alt="" kind="collage" focus={focus[2]} />
    <span class="sq sq1"></span><span class="sq sq2"></span><span class="sq sq3"></span>
  </div>
</section>
