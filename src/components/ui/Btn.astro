---
/**
 * The site's one button: a hairline box with caps label and a dot either
 * side; hovering wipes the fill up from the bottom and pulls the dots in.
 * With `href` it is a link; with `type` (and no `href`) it is a real
 * <button>, used for the contact form's Send.
 */
import type { HTMLAttributes } from "astro/types";
import { useI18n } from "@/i18n";

type Variant = "light" | "paper" | "dark";
type LinkProps = HTMLAttributes<"a"> & { href: string; type?: never };
type ButtonProps = Omit<HTMLAttributes<"button">, "type"> & { href?: never; type: "submit" | "button" };
type Props = (LinkProps | ButtonProps) & { label: string; variant?: Variant };

const { href, type, label, variant = "light", class: className, ...rest } = Astro.props;
const { path } = useI18n(Astro.url);
const classes = ["btn", `btn--${variant}`, className];
---

{
  href !== undefined ? (
    <a href={path(href)} class:list={classes} {...(rest as HTMLAttributes<"a">)}>
      <span class="btn__dot" aria-hidden="true" /><span class="btn__label">{label}</span><span
        class="btn__dot"
        aria-hidden="true"
      />
    </a>
  ) : (
    <button type={type} class:list={classes} {...(rest as HTMLAttributes<"button">)}>
      <span class="btn__dot" aria-hidden="true" /><span class="btn__label">{label}</span><span
        class="btn__dot"
        aria-hidden="true"
      />
    </button>
  )
}
