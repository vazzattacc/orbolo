---
import type { PathCard } from "../../lib/paths/path-repository";

interface Props {
  path: PathCard;
}

const { path } = Astro.props;
const backId = `${path.id}-back`;
---

<li class="path-card relative list-none" data-path-card data-flipped="false">
  <div class="path-card__stage">
    <div class="path-card__flipper">
      <div class="path-card__face path-card__face--front path-card__front">
        <span class="path-card__image-wrap">
          <img
            src={path.image.src}
            alt={path.image.alt}
            width="800"
            height="600"
            loading="lazy"
            decoding="async"
            class="path-card__image"
            onerror="this.closest('.path-card__image-wrap')?.classList.add('path-card__image-wrap--fallback')"
          />
        </span>
        <span class="path-card__arrow" aria-hidden="true"></span>
        <p class="caps t-lime">{path.targetAudience}</p>
        <h3 class="path-card__title">{path.title}</h3>
        <p class="caps caps--sm line-clamp-3">{path.description}</p>
        <button
          type="button"
          class="path-card__trigger"
          aria-expanded="false"
          aria-controls={backId}
          aria-label={`View more about ${path.title}`}
          data-path-card-trigger></button>
      </div>

      <div id={backId} class="path-card__face path-card__face--back path-card__back" data-path-card-back>
        <div class="flex flex-col gap-3">
          <p class="caps">{path.targetAudience}</p>
          <h3 class="path-card__title">{path.title}</h3>
          <p class="copy">{path.description}</p>
        </div>
        <div class="path-card__actions">
          <a href={path.destination} class="btn btn--dark path-card__discover" data-path-card-discover>
            <span class="btn__dot" aria-hidden="true"></span><span class="btn__label">Discover more</span><span
              class="btn__dot"
              aria-hidden="true"></span>
          </a>
          <button
            type="button"
            class="path-card__close caps ulink min-h-[44px] min-w-[44px] cursor-pointer px-2"
            aria-label={`Flip the ${path.title} card back`}
            data-path-card-close>
            Back
          </button>
        </div>
      </div>
    </div>
  </div>
</li>
