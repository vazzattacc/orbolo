---
import { getLegalDocument } from "@/lib/legal/legal-repository";

// FR-LEG-001: a link renders only when its destination page actually
// ships — getLegalDocument() already collapses "missing" and "not yet
// approved" into the same undefined signal (research.md §5), so this
// component never re-checks an `approved` flag itself.
const privacy = await getLegalDocument("privacy");
const terms = await getLegalDocument("terms");
const year = new Date().getFullYear();
---

<footer aria-label="Legal" class="footer">
  <div class="footer__top">
    <p class="script t-lime">a work relationship with nature</p>
    <p class="caps">Gran Chaco · Paraguay</p>
  </div>
  <div class="footer__bottom">
    <span class="caps caps--sm">© {year} Orbolo</span>
    <img class="footer__logo" src="/images/brand/logo-paper.svg" alt="Orbolo" width="470" height="219" loading="lazy" />
    <span class="caps caps--sm footer__legal">
      {privacy && <a href="/privacy" class="ulink">Privacy</a>}
      {terms && <a href="/terms" class="ulink">Terms</a>}
    </span>
  </div>
</footer>
