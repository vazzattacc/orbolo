---
import Layout from "../components/Layout.astro";
import PathGrid from "../components/home/PathGrid.astro";
import PhotoHero from "../components/ui/PhotoHero.astro";
import Btn from "../components/ui/Btn.astro";
import { getPaths } from "../lib/paths/path-repository";

const paths = await getPaths();
// the strip repeats its words twice so the -50% loop is seamless
const stripWords = paths.length > 0 ? paths.map((p) => p.targetAudience) : ["Cattle", "Land", "Beef"];
const stripLoop = [...stripWords, ...stripWords, ...stripWords, ...stripWords];
---

<Layout title="Orbolo">
  <PhotoHero image="/images/site/hero-mist.jpg" class="hero" scrollCue>
    <h1 class="h1 t-paper" data-split>
      You own the cattle. Our ranches raise them. Buyers get the beef.
    </h1>
    <p class="script t-paper" aria-hidden="true">a work relationship with nature</p>
    <Fragment slot="side">
      <p class="caps">
        Grass-fed beef from Paraguay&rsquo;s Gran Chaco, where cattle have grazed for more than 400 years. Pick
        your way in.
      </p>
      <Btn href="#paths" label="Explore paths" variant="paper" />
    </Fragment>
  </PhotoHero>

  <div class="strip" aria-hidden="true">
    <div class="strip__track">
      {
        stripLoop.map((word, i) => (
          <>
            <span class:list={["strip__word", { "strip__word--lime": i % 2 === 1 }]}>{word}</span>
            <i />
          </>
        ))
      }
    </div>
  </div>

  <section id="paths" aria-labelledby="paths-heading" class="path-grid-section paths">
    <h2 id="paths-heading" class="h2 t-lime" data-split>Find your path</h2>
    <PathGrid paths={paths} />
  </section>

  <script src="../scripts/path-card-flip.ts"></script>
</Layout>
