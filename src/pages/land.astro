---
import Layout from "../components/Layout.astro";
import ElTapir from "../components/land/ElTapir.astro";
import PartnerRanches from "../components/land/PartnerRanches.astro";
import GanaderiaAPasto from "../components/land/GanaderiaAPasto.astro";
import WorkWithUs from "../components/land/WorkWithUs.astro";
import { getLandPage } from "../lib/land/land-repository";

const page = await getLandPage();
---

<Layout title="Land — Orbolo">
  <ElTapir {...page.elTapir} />
  <PartnerRanches ranchSlugs={page.partnerRanches?.ranchSlugs} />
  <GanaderiaAPasto {...page.ganaderiaAPasto} />
  <WorkWithUs {...page.workWithUs} />
</Layout>
