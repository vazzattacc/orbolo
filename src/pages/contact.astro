---
import Layout from "../components/Layout.astro";
import PhotoHero from "../components/ui/PhotoHero.astro";
---

<Layout title="Contact — Orbolo">
  <PhotoHero image="/images/site/brahman-four.jpg" trail>
    <h1 class="h1 h1--xl t-paper" data-split>Contact</h1>
    <Fragment slot="side">
      <p class="lede">Own a herd, buy beef, or bring your land: this is where we talk. Our contact form is on its way.</p>
    </Fragment>
  </PhotoHero>
</Layout>
