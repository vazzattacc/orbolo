---
import Layout from "../components/Layout.astro";
---

<Layout title="Contact — Orbolo">
  <div class="flex min-h-screen flex-col items-center justify-center gap-4 bg-orbolo-cream px-4 text-center">
    <h1 class="font-subtitle text-4xl text-orbolo-green">Contact</h1>
    <p class="font-body max-w-xl text-lg text-orbolo-green/80">
      This is a placeholder destination. The real Contact page and form are a separate feature — this stub exists so
      the site-wide Contact link (in the top navigation bar) always resolves to a real page rather than a broken
      link, per OQ-015.
    </p>
  </div>
</Layout>
