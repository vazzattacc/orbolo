---
import Layout from "../components/Layout.astro";
import Hero from "../components/beef/Hero.astro";
import WhatWeSellToday from "../components/beef/WhatWeSellToday.astro";
import Promise from "../components/beef/Promise.astro";
import Roadmap from "../components/beef/Roadmap.astro";
import FirstPick from "../components/beef/FirstPick.astro";
import WhySupplyDifferent from "../components/beef/WhySupplyDifferent.astro";
import WhoVerifies from "../components/beef/WhoVerifies.astro";
import Ctas from "../components/beef/Ctas.astro";
import CrossLink from "../components/shared/CrossLink.astro";
import { getBeefPage } from "../lib/beef/beef-repository";

const page = await getBeefPage();
---

<Layout title="Beef — Orbolo">
  <Hero {...page.hero} />
  <WhatWeSellToday {...page.whatWeSellToday} />
  <Promise {...page.promise} />
  <Roadmap milestones={page.roadmap?.milestones} />
  <FirstPick {...page.firstPick} />
  <WhySupplyDifferent {...page.whySupplyDifferent} />
  <WhoVerifies {...page.whoVerifies} />
  <Ctas ctas={page.ctas} />
  <CrossLink {...page.crossLinkToInvest} />
</Layout>
