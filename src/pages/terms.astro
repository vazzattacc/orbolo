---
import Layout from "../components/Layout.astro";
import { getLegalDocument } from "../lib/legal/legal-repository";

const document = await getLegalDocument("terms");
---

<Layout title="Terms — Orbolo" noindex={!document}>
  {
    document ? (
      <div class="prose-page">
        <div class="flex flex-col gap-4">
          <h1 class="h1 t-paper" data-split>Terms</h1>
          <p class="caps caps--sm t-lime">
            {document.sourceLastUpdated ? `Last updated ${document.sourceLastUpdated}` : `Fetched ${document.fetchedOn}`}
          </p>
        </div>
        {document.body.map((section) => (
          <section>
            <h2 class="h3 t-lime">{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p class="copy">{paragraph}</p>
            ))}
          </section>
        ))}
      </div>
    ) : (
      <div class="prose-page min-h-[70svh] content-center text-center">
        <h1 class="h1 t-paper" data-split>Terms</h1>
        <p class="caps">This page isn’t available yet.</p>
      </div>
    )
  }
</Layout>
