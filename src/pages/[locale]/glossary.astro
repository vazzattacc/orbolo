---
import { getAllGlossaryTerms } from "@/lib/content/glossary";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { LOCALES, type Locale } from "@/i18n/routing";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };

const terms = (await getAllGlossaryTerms(locale)).sort((a, b) => a.term.localeCompare(b.term));
---

<BaseLayout locale={locale} title="Glossary" description="Term, our definition, how it's measured, what it is not." path="/glossary">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="max-w-3xl">
      <h1 class="font-display text-4xl">Glossary</h1>
      <dl class="mt-8 flex flex-col gap-8">
        {
          terms.map((term) => (
            <div class="border-t border-ink/10 pt-6">
              <dt class="font-display text-xl capitalize">{term.term}</dt>
              <dd class="mt-2 flex flex-col gap-1 text-ink/80">
                <p>{term.definition}</p>
                <p class="text-sm text-ink/60">Measured by: {term.measuredBy}</p>
                <p class="text-sm text-ink/60">Not this: {term.notThis}</p>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>
