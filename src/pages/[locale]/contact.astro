---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FormEmbed from "@/components/sections/FormEmbed.astro";
import { LOCALES, type Locale } from "@/i18n/routing";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
---

<BaseLayout locale={locale} title="Contact" description="Reach the right team, or book a call." path="/contact">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="max-w-3xl">
      <h1 class="font-display text-4xl">Contact</h1>
      <p class="mt-2 text-ink/70">Choose the form that matches you, or book a call directly.</p>
      <p class="mt-4">
        <a href="https://calendar.google.com/calendar/appointments" class="underline">
          Book a call (Google Calendar)
        </a>
      </p>
    </div>
  </section>
  <FormEmbed formId="" audience="investor" />
  <FormEmbed formId="" audience="buyer" />
  <FormEmbed formId="" audience="landowner" />
  <FormEmbed formId="" audience="general" />
</BaseLayout>
