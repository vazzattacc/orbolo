---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionRenderer from "@/components/SectionRenderer.astro";
import { getPage } from "@/lib/content/pages";
import { getSettings } from "@/lib/content/settings";
import { LOCALES, type Locale } from "@/i18n/routing";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const page = await getPage("invest", locale);
if (!page) return Astro.redirect("/en/invest");

// FR-034: every investor-facing page carries a footer line naming the
// contracting entity.
const settings = await getSettings();
---

<BaseLayout locale={locale} title={page.title} description={page.seoDescription} path="/invest" isFallback={page.isFallback}>
  {page.sections.map((section) => <SectionRenderer section={section} locale={locale} />)}
  <Fragment slot="contracting-entity-line">{settings?.contractingEntityLine}</Fragment>
</BaseLayout>
